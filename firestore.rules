// firestore.rules
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Administradores — manter igual a src/lib/admin.ts
    function isAdmin() {
      return request.auth != null && (
        request.auth.uid == 'kXNpNTLYe5P55PhI8K4VrZSahOC2'
        || request.auth.token.email in [
          'mauriciomg_2010@hotmail.com',
          'daianeschlichting83@gmail.com'
        ]
      );
    }

    // Users: authenticated users can read all profiles
    // Write: create own doc, update own doc, OR update another's doc (for referral counter increments)
    match /users/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.id == request.auth.uid;
      allow update: if request.auth != null;
      // apagar perfil: só o próprio usuário ou admin (antes qualquer um podia apagar qualquer perfil)
      allow delete: if request.auth != null && (request.auth.uid == docId || resource.data.id == request.auth.uid || isAdmin());
    }

    // Incidents: authenticated users can read and create their own
    // Update: owner can update freely; non-owners can vote only if they haven't voted yet
    match /incidents/{incidentId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null
        && (
          resource.data.userId == request.auth.uid
          || !('voters' in resource.data)
          || !(request.auth.uid in resource.data.voters)
        );
      // apagar report: só o autor ou admin (os reports são a base de dados do projeto)
      allow delete: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Groups
    match /groups/{groupId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null
        && (request.auth.uid == resource.data.adminId
            || request.auth.uid == resource.data.ownerId
            || request.auth.uid == resource.data.createdBy
            || request.auth.uid == resource.data.admin
            || request.auth.uid in resource.data.members);
    }

    // Alerts
    match /alerts/{alertId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null;
    }

    // Emergencies
    match /emergencies/{emergencyId} {
      allow read, create, update, delete: if request.auth != null;
    }

    // Services
    match /services/{serviceId} {
      allow read, create, update, delete: if request.auth != null;
    }

    // Service providers
    match /service_providers/{providerId} {
      allow read, create, update, delete: if request.auth != null;
    }

    // Help requests
    match /helpRequests/{requestId} {
      allow read, create, update, delete: if request.auth != null;
    }

    // Push tokens: only owner
    match /users/{userId}/pushTokens/{tokenId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Risk zones
    // • Zonas desenhadas (manuais / permanentes): só administradores criam, editam ou apagam.
    // • Zonas automáticas (geradas pelos reports, id AUTO-...): o app de qualquer usuário pode
    //   criar/atualizar/remover, mas NUNCA transformá-las em manuais ou permanentes.
    match /risk_zones/{zoneId} {
      function isAutoData(d) {
        return d.source == 'auto_clustering' && d.isPermanent == false;
      }
      allow read: if request.auth != null;
      allow create: if isAdmin()
        || (request.auth != null && zoneId.matches('AUTO-.*') && isAutoData(request.resource.data));
      allow update: if isAdmin()
        || (request.auth != null && isAutoData(resource.data) && isAutoData(request.resource.data));
      allow delete: if isAdmin()
        || (request.auth != null && isAutoData(resource.data));
    }

    // Referral codes — public read (unauthenticated signup flow)
    match /referralCodes/{code} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
    }

    // Referrals — any authenticated user can read/write (signup creates entries)
    match /referrals/{referralId} {
      allow read, create, update: if request.auth != null;
      allow delete: if request.auth != null;
    }

    // Feedback — authenticated users can submit and read
    match /feedback/{feedbackId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
    }

    // Migrations — internal flags (admin only effectively)
    match /migrations/{migrationId} {
      allow read, write: if request.auth != null;
    }

    // Partners — read only for authenticated users
    match /partners/{partnerId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Credit claims
    match /creditClaims/{claimId} {
      allow read, create: if request.auth != null;
    }
  }
}
